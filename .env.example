# Port (defaults to 3000 in AI Studio)
PORT=3000

# Optional persistent encryption secret for server-side AES-256-GCM key storage
PORTAL_ENCRYPTION_SECRET=

# Gemini API Key (Optional fallback if user has not configured key via UI)
GEMINI_API_KEY=

# Firebase Web API Key (Extracted from firebase-applet-config.json)
FIREBASE_API_KEY=
